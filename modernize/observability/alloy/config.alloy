// =====================================================================
// Grafana Alloy — the single OTLP collector for the modernized SSO
// stack ("máximo Grafana": one agent, one protocol).
//
// Every Spring service (api-gateway, auth-center, sso-admin,
// query-service, provisioner, hello-service) pushes OTLP over the
// compose network to alloy:4318 (HTTP) / alloy:4317 (gRPC). The React
// SPA pushes Real-User-Monitoring to the Faro receiver on :12347.
//
// Alloy fans everything out to the LGTM backends:
//   traces  -> Tempo   (otlp gRPC)
//   metrics -> Mimir   (prometheus remote_write)
//   logs    -> Loki    (native OTLP ingestion, Loki 3.x)
// =====================================================================

// ---- OTLP receiver: every Spring service pushes here ---------------
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Batching smooths export bursts and cuts backend round-trips.
otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.mimir.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// ---- Traces -> Tempo (OTLP gRPC) ----------------------------------
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

// ---- Metrics -> Mimir ---------------------------------------------
// OTLP metrics are converted to the Prometheus data model and pushed
// to Mimir's remote_write endpoint. Mimir is Prometheus-compatible,
// so nothing on the app side knows or cares it isn't Prometheus.
otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}
prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

// ---- Logs -> Loki (native OTLP ingestion, Loki 3.x) ---------------
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

// ---- Faro receiver: RUM from the React SPA ------------------------
// The browser POSTs page loads, JS errors, Web Vitals and frontend
// spans here. Logs land in Loki; browser spans join the same Tempo
// trace graph as the backend spans (end-to-end SPA -> gateway ->
// service correlation).
faro.receiver "spa" {
  server {
    listen_address       = "0.0.0.0"
    listen_port          = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    logs   = [loki.write.faro.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}
loki.write "faro" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---- Prometheus scrape blocks --------------------------------------
// Every Spring service in this stack exposes
// /actuator/prometheus over the compose network. Alloy scrapes each
// one on a 15s interval, tags the metrics with `service` and
// `container`, and forwards them to Mimir via the same
// prometheus.remote_write target the OTLP path uses (no duplication).
//
// The metrics the scraper picks up are Micrometer's standard set:
// jvm_memory_*, jvm_gc_*, process_cpu_*, http_server_requests_*
// (per route / status), hikaricp_*, jdbc_connections_*, plus
// tomcat_*. api-gateway also pushes the same metrics via OTLP —
// Mimir deduplicates on (service, instance, metric) labels so the
// two paths coexist cleanly; whichever interval fires first wins
// until the next scrape overwrites it.
prometheus.scrape "api_gateway" {
  targets    = [{__address__ = "api-gateway:8080"}]
  job_name   = "sso/api-gateway"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.add_service_api_gateway.receiver]
}
prometheus.scrape "auth_center" {
  targets    = [{__address__ = "auth-center:8081"}]
  job_name   = "sso/auth-center"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.add_service_auth_center.receiver]
}
prometheus.scrape "hello_service" {
  targets    = [{__address__ = "hello-service:8082"}]
  job_name   = "sso/hello-service"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.add_service_hello_service.receiver]
}
prometheus.scrape "sso_admin" {
  targets    = [{__address__ = "sso-admin:8083"}]
  job_name   = "sso/sso-admin"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.add_service_sso_admin.receiver]
}
prometheus.scrape "query_service" {
  targets    = [{__address__ = "query-service-postgres:8084"}]
  job_name   = "sso/query-service"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.add_service_query_service.receiver]
}
prometheus.scrape "provisioner" {
  targets    = [{__address__ = "provisioner:9000"}]
  job_name   = "sso/provisioner"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.add_service_provisioner.receiver]
}
prometheus.scrape "eurekaserver" {
  targets    = [{__address__ = "eurekaserver:8761"}]
  job_name   = "sso/eurekaserver"
  metrics_path = "/actuator/prometheus"
  scrape_interval = "30s"
  forward_to = [prometheus.relabel.add_service_eurekaserver.receiver]
}

// Relabel — pin a `service=<spring.application.name>` label so panels
// can group by service. Then forward everything to Mimir.
prometheus.relabel "add_service_api_gateway" {
  rule {
    action        = "replace"
    source_labels = ["job"]
    target_label  = "service"
    replacement   = "api-gateway"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}
prometheus.relabel "add_service_auth_center" {
  rule {
    action        = "replace"
    source_labels = ["job"]
    target_label  = "service"
    replacement   = "auth-center"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}
prometheus.relabel "add_service_hello_service" {
  rule {
    action        = "replace"
    source_labels = ["job"]
    target_label  = "service"
    replacement   = "hello-service"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}
prometheus.relabel "add_service_sso_admin" {
  rule {
    action        = "replace"
    source_labels = ["job"]
    target_label  = "service"
    replacement   = "sso-admin"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}
prometheus.relabel "add_service_query_service" {
  rule {
    action        = "replace"
    source_labels = ["job"]
    target_label  = "service"
    replacement   = "query-service"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}
prometheus.relabel "add_service_provisioner" {
  rule {
    action        = "replace"
    source_labels = ["job"]
    target_label  = "service"
    replacement   = "provisioner"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}
prometheus.relabel "add_service_eurekaserver" {
  rule {
    action        = "replace"
    source_labels = ["job"]
    target_label  = "service"
    replacement   = "eurekaserver"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// ---- Loki: tail Docker container logs ------------------------------
// TODO(re-enable): loki.source.docker needs the
// loki.relabel component (or stage.parsed_regex) wired up
// properly — the inline heredoc + relabel_rules syntax
// triggers parser errors in Alloy 1.x. Skipping for now
// means container stdout lands in Loki ONLY when a service
// has OTLP logging enabled (api-gateway does; the others
// don't yet). This is enough for the SSO flow dashboards
// to work; the per-container docker log view can be wired
// in a follow-up.
